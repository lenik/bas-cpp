#: src/bas/security/UserStoreCommand.cpp:34
msgid ""
"user store commands:\n"
"  user list                       list usernames\n"
"  user show USER                  show profile, roles, keys\n"
"  user add [options] USER [PASSWORD]\n"
"  user update [options] USER [PASSWORD]\n"
"      -a/--avatar NAME   -d/--display NAME   -e/--email EMAIL\n"
"      -p/--password PASS  [PASSWORD] positional\n"
"      -H/--hash ALGO      plain (default), sha256, sha1, md5\n"
"      -h/--help           show command help\n"
"      -r/--roles ROLES    comma-separated role names\n"
"      password from stdin when -p and [PASSWORD] are both omitted\n"
"  user check USER [PASSWORD]        validate password (exit 1 on failure)\n"
"  user del USER                   remove user\n"
"  user enable USER | user disable USER\n"
"  user roles USER | user roles set USER R…\n"
"  user role add USER ROLE | user role del USER ROLE\n"
"  user keys USER | user key add/del …\n"
"  path | reload | save | help\n"
"  commands may be abbreviated by unique prefix\n"
"  -h/--help on any subcommand shows its usage\n"
msgstr ""
"comandos del almacén de usuarios:\n"
"  user list                       listar nombres de usuario\n"
"  user show USER                  mostrar perfil, roles, claves\n"
"  user add [options] USER [PASSWORD]\n"
"  user update [options] USER [PASSWORD]\n"
"      -a/--avatar NAME   -d/--display NAME   -e/--email EMAIL\n"
"      -p/--password PASS  [PASSWORD] posicional\n"
"      -H/--hash ALGO      plain (predeterminado), sha256, sha1, md5\n"
"      -h/--help           mostrar ayuda del comando\n"
"      -r/--roles ROLES    nombres de rol separados por comas\n"
"      contraseña desde stdin cuando se omiten -p y [PASSWORD]\n"
"  user check USER [PASSWORD]        validar contraseña (salida 1 si falla)\n"
"  user del USER                   eliminar usuario\n"
"  user enable USER | user disable USER\n"
"  user roles USER | user roles set USER R…\n"
"  user role add USER ROLE | user role del USER ROLE\n"
"  user keys USER | user key add/del …\n"
"  path | reload | save | help\n"
"  los comandos se pueden abreviar por prefijo único\n"
"  -h/--help en cualquier subcomando muestra su uso\n"

#: src/bas/security/UserStoreCommand.cpp:57
msgid ""
"usage: user list [-h]\n"
"  List all usernames in the store.\n"
msgstr ""
"uso: user list [-h]\n"
"  Listar todos los nombres de usuario del almacén.\n"

#: src/bas/security/UserStoreCommand.cpp:62
msgid ""
"usage: user show [-h] USER\n"
"  Show profile, roles, and auth keys for USER.\n"
msgstr ""
"uso: user show [-h] USER\n"
"  Mostrar perfil, roles y claves de autenticación de USER.\n"

#: src/bas/security/UserStoreCommand.cpp:67
msgid ""
"usage: user add [-h] [options] USER [PASSWORD]\n"
"  Create a new user record.\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    display name\n"
"  -e, --email EMAIL     email address\n"
"  -p, --password PASS   password (or positional PASSWORD)\n"
"  -H, --hash ALGO       plain (default), sha256, sha1, md5\n"
"  -r, --roles ROLES     comma-separated role names (default: operator)\n"
"  -h, --help            show this help\n"
"  If neither -p nor PASSWORD is given, password is read from stdin.\n"
msgstr ""
"uso: user add [-h] [options] USER [PASSWORD]\n"
"  Crear un nuevo registro de usuario.\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    nombre para mostrar\n"
"  -e, --email EMAIL     dirección de correo\n"
"  -p, --password PASS   contraseña (o PASSWORD posicional)\n"
"  -H, --hash ALGO       plain (predeterminado), sha256, sha1, md5\n"
"  -r, --roles ROLES     nombres de rol separados por comas (predeterminado: operator)\n"
"  -h, --help            mostrar esta ayuda\n"
"  Si no se dan -p ni PASSWORD, la contraseña se lee desde stdin.\n"

#: src/bas/security/UserStoreCommand.cpp:81
msgid ""
"usage: user update [-h] [options] USER [PASSWORD]\n"
"  Update an existing user; only specified fields are changed.\n"
"options: same as user add\n"
msgstr ""
"uso: user update [-h] [options] USER [PASSWORD]\n"
"  Actualizar un usuario existente; solo cambian los campos indicados.\n"
"options: iguales que user add\n"

#: src/bas/security/UserStoreCommand.cpp:87
msgid ""
"usage: user check [-h] USER [PASSWORD]\n"
"  Validate PASSWORD against USER's stored keys (exit 1 on failure).\n"
"  PASSWORD from stdin when omitted.\n"
msgstr ""
"uso: user check [-h] USER [PASSWORD]\n"
"  Validar PASSWORD contra las claves almacenadas de USER (salida 1 si falla).\n"
"  PASSWORD desde stdin si se omite.\n"

#: src/bas/security/UserStoreCommand.cpp:93
msgid ""
"usage: user del|rm [-h] USER\n"
"  Remove USER from the store.\n"
msgstr ""
"uso: user del|rm [-h] USER\n"
"  Eliminar USER del almacén.\n"

#: src/bas/security/UserStoreCommand.cpp:98
msgid ""
"usage: user enable|disable [-h] USER\n"
"  Enable or disable USER login.\n"
