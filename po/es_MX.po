#: app/acdemo.cpp:102
msgid ""
"acdemo — bas.security permissions, credentials, and console login demo\n"
"\n"
"usage: acdemo [options] [command [args...]]\n"
"\n"
"  If no command is given, starts an interactive shell.\n"
"\n"
"commands:\n"
"  check [@realm] PERMISSION       check permission (optional realm scope)\n"
"  request [@realm] PERMISSION [USER]  request permission (login if needed)\n"
"  login [@realm] [USER]             interactive login → active identities\n"
"  whoami                            list active identities\n"
"  creds [-v]                        list cached credentials (no secrets)\n"
"  sm                                enter security manager shell\n"
"  us                                enter user store shell\n"
"  cm                                enter credential manager shell\n"
"  ps                                enter policy store shell\n"
"  reg                               enter identity registry shell\n"
"  id                                enter identity service shell (current realm)\n"
"  realm show|NAME|@realm            show or switch current realm\n"
"  realms                            list registered realms\n"
"  logout                            clear all active identities\n"
"  logout-realm [NAME]               clear identities in a realm\n"
"  reload-creds                      reload credentials and restore cached logins\n"
"  help                              show this help\n"
"\n"
"  Interactive shells: sm, store, acl, cm, reg, id (exit or Ctrl-D to leave)\n"
"  One-shot: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  @realm syntax:\n"
"    @factory-a          realm name\n"
"    @device:tablet-1    realm type + name (types: global, device, app)\n"
"    @device             realm type only\n"
"\n"
"options:\n"
"  (global options must appear before the subcommand, e.g. acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          credential cache file\n"
"  -d, --user-db FILE                user store JSON file (default: built-in demo)\n"
"  -p, --policy-db FILE              policy store JSON file (default: built-in demo)\n"
"  -u, --subject USER                default subject hint\n"
"  -r, --realm NAME                  default realm name\n"
"      --realm-type TYPE             default realm type (global|device|app)\n"
"      --realm-uuid UUID             default realm uuid\n"
"      --version                     print version and exit\n"
"  -h, --help                        show help and exit\n"
"\n"
"demo permissions (ACL is built-in):\n"
"  action=view;resource=fab.order / action=modify;resource=fab.order /\n"
"  action=delete;resource=fab.order / action=save;resource=file\n"
msgstr ""
"acdemo — demo bas.security de permisos, credenciales e inicio de sesión en consola\n"
"\n"
"uso: acdemo [options] [command [args...]]\n"
"\n"
"  Sin comando, inicia un shell interactivo.\n"
"\n"
"comandos:\n"
"  check [@realm] PERMISSION       comprobar permiso (ámbito de realm opcional)\n"
"  request [@realm] PERMISSION [USER]  solicitar permiso (login si hace falta)\n"
"  login [@realm] [USER]             login interactivo → identidades activas\n"
"  whoami                            listar identidades activas\n"
"  creds [-v]                        listar credenciales en caché (sin secretos)\n"
"  sm                                entrar al shell del gestor de seguridad\n"
"  us                                entrar al shell del almacén de usuarios\n"
"  cm                                entrar al shell del gestor de credenciales\n"
"  ps                                entrar al shell del almacén de políticas\n"
"  reg                               entrar al shell del registro de identidades\n"
"  id                                entrar al shell del servicio de identidad (realm actual)\n"
"  realm show|NAME|@realm            mostrar o cambiar el realm actual\n"
"  realms                            listar realms registrados\n"
"  logout                            borrar todas las identidades activas\n"
"  logout-realm [NAME]               borrar identidades de un realm\n"
"  reload-creds                      recargar credenciales y restaurar logins en caché\n"
"  help                              mostrar esta ayuda\n"
"\n"
"  Shells interactivos: sm, store, acl, cm, reg, id (exit o Ctrl-D para salir)\n"
"  Una vez: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  Sintaxis @realm:\n"
"    @factory-a          nombre de realm\n"
"    @device:tablet-1    tipo de realm + nombre (tipos: global, device, app)\n"
"    @device             solo tipo de realm\n"
"\n"
"options:\n"
"  (las opciones globales deben ir antes del subcomando, p. ej. acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          archivo de caché de credenciales\n"
"  -d, --user-db FILE                archivo JSON del almacén de usuarios (predeterminado: demo integrada)\n"
"  -p, --policy-db FILE              archivo JSON del almacén de políticas (predeterminado: demo integrada)\n"
"  -u, --subject USER                sujeto predeterminado\n"
"  -r, --realm NAME                  nombre de realm predeterminado\n"
"      --realm-type TYPE             tipo de realm predeterminado (global|device|app)\n"
"      --realm-uuid UUID             uuid de realm predeterminado\n"
"      --version                     imprimir versión y salir\n"
"  -h, --help                        mostrar ayuda y salir\n"
"\n"
"permisos de demo (ACL integrada):\n"
"  action=view;resource=fab.order / action=modify;resource=fab.order /\n"
"  action=delete;resource=fab.order / action=save;resource=file\n"

