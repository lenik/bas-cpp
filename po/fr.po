#: app/vols.cpp:39
msgid ""
"usage: vols [options]\n"
"  Field selection (default without any: -mdtlu; with -v: -mdtlurLD):\n"
"    -a, --all            all columns\n"
"    -c, --compact        same columns as -mdtlu (merges with explicit field flags)\n"
"    -m, --mountpoint     mount point column\n"
"    -d, --device         device column\n"
"    -t, --type           type column\n"
"    -l, --label          label column\n"
"    -u, --uuid           UUID column\n"
"    -r, --read-only      read-only (ro/rw) column\n"
"    -L, --logical-type   logical type column\n"
"    -D, --loop-device    loop device column\n"
"    -o, --opts           per-mount (VFS) options from mountinfo\n"
"    -O, --superopts      superblock options from mountinfo\n"
"    -z, --root           root path within filesystem (mountinfo field)\n"
"  Other:\n"
"    -s, --symbols        include overlay filesystems in the scan (bind mounts always on)\n"
"    -h, --help           show this help and exit\n"
"    -w, --writable       list only writable mounts; implies -r\n"
"    -v, --verbose        more log detail; default columns include logical type\n"
"    -q, --quiet          only errors on stderr\n"
msgstr ""
"usage : vols [options]\n"
"  Sélection des champs (par défaut sans aucun : -mdtlu ; avec -v : -mdtlurLD) :\n"
"    -a, --all            toutes les colonnes\n"
"    -c, --compact        mêmes colonnes que -mdtlu (se combine avec les drapeaux de champ explicites)\n"
"    -m, --mountpoint     colonne point de montage\n"
"    -d, --device         colonne périphérique\n"
"    -t, --type           colonne type\n"
"    -l, --label          colonne étiquette\n"
"    -u, --uuid           colonne UUID\n"
"    -r, --read-only      colonne lecture seule (ro/rw)\n"
"    -L, --logical-type   colonne type logique\n"
"    -D, --loop-device    colonne périphérique loop\n"
"    -o, --opts           options par montage (VFS) depuis mountinfo\n"
"    -O, --superopts      options de superbloc depuis mountinfo\n"
"    -z, --root           chemin racine dans le système de fichiers (champ mountinfo)\n"
"  Autres :\n"
"    -s, --symbols        inclure les systèmes de fichiers overlay dans le scan (bind mounts toujours actifs)\n"
"    -h, --help           afficher cette aide et quitter\n"
"    -w, --writable       n’afficher que les montages en écriture ; implique -r\n"
"    -v, --verbose        plus de détails de journal ; colonnes par défaut incluent le type logique\n"
"    -q, --quiet          erreurs uniquement sur stderr\n"

