"  -H, --hash ALGO       for password-hash (default plain → password-plain)\n"
"  --name LABEL          key display name\n"
"  -h, --help            show this help\n"
msgstr ""
"الاستخدام: user key add [-h] USER ID TYPE [options]\n"
"       user key del [-h] USER ID\n"
"options للإضافة:\n"
"  -p, --password PASS   سر المفتاح\n"
"  -H, --hash ALGO       لـ password-hash (افتراضي plain → password-plain)\n"
"  --name LABEL          اسم عرض المفتاح\n"
"  -h, --help            عرض هذه المساعدة\n"

