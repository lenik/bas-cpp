#: app/acdemo.cpp:102
msgid ""
"acdemo — bas.security permissions, credentials, and console login demo\n"
"\n"
"usage: acdemo [options] [command [args...]]\n"
"\n"
"  If no command is given, starts an interactive shell.\n"
"\n"
"commands:\n"
"  check [@realm] PERMISSION       check permission (optional realm scope)\n"
"  request [@realm] PERMISSION [USER]  request permission (login if needed)\n"
"  login [@realm] [USER]             interactive login → active identities\n"
"  whoami                            list active identities\n"
"  creds [-v]                        list cached credentials (no secrets)\n"
"  sm                                enter security manager shell\n"
"  us                                enter user store shell\n"
"  cm                                enter credential manager shell\n"
"  ps                                enter policy store shell\n"
"  reg                               enter identity registry shell\n"
"  id                                enter identity service shell (current realm)\n"
"  realm show|NAME|@realm            show or switch current realm\n"
"  realms                            list registered realms\n"
"  logout                            clear all active identities\n"
"  logout-realm [NAME]               clear identities in a realm\n"
"  reload-creds                      reload credentials and restore cached logins\n"
"  help                              show this help\n"
"\n"
"  Interactive shells: sm, store, acl, cm, reg, id (exit or Ctrl-D to leave)\n"
"  One-shot: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  @realm syntax:\n"
"    @factory-a          realm name\n"
"    @device:tablet-1    realm type + name (types: global, device, app)\n"
"    @device             realm type only\n"
"\n"
"options:\n"
"  (global options must appear before the subcommand, e.g. acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          credential cache file\n"
"  -d, --user-db FILE                user store JSON file (default: built-in demo)\n"
"  -p, --policy-db FILE              policy store JSON file (default: built-in demo)\n"
"  -u, --subject USER                default subject hint\n"
"  -r, --realm NAME                  default realm name\n"
"      --realm-type TYPE             default realm type (global|device|app)\n"
"      --realm-uuid UUID             default realm uuid\n"
"      --version                     print version and exit\n"
"  -h, --help                        show help and exit\n"
"\n"
"demo permissions (ACL is built-in):\n"
"  action=view;resource=fab.order / action=modify;resource=fab.order /\n"
"  action=delete;resource=fab.order / action=save;resource=file\n"
msgstr ""
"acdemo — عرض توضيحي لـ bas.security للأذونات وبيانات الاعتماد وتسجيل الدخول من الطرفية\n"
"\n"
"الاستخدام: acdemo [options] [command [args...]]\n"
"\n"
"  بدون أمر، يبدأ صدفة تفاعلية.\n"
"\n"
"الأوامر:\n"
"  check [@realm] PERMISSION       التحقق من الإذن (نطاق realm اختياري)\n"
"  request [@realm] PERMISSION [USER]  طلب الإذن (تسجيل دخول عند الحاجة)\n"
"  login [@realm] [USER]             تسجيل دخول تفاعلي ← هويات نشطة\n"
"  whoami                            سرد الهويات النشطة\n"
"  creds [-v]                        سرد بيانات الاعتماد المخزّنة (بدون أسرار)\n"
"  sm                                الدخول إلى صدفة مدير الأمان\n"
"  us                                الدخول إلى صدفة مخزن المستخدمين\n"
"  cm                                الدخول إلى صدفة مدير بيانات الاعتماد\n"
"  ps                                الدخول إلى صدفة مخزن السياسات\n"
"  reg                               الدخول إلى صدفة سجل الهويات\n"
"  id                                الدخول إلى صدفة خدمة الهوية (الـ realm الحالي)\n"
"  realm show|NAME|@realm            عرض أو تبديل الـ realm الحالي\n"
"  realms                            سرد الـ realms المسجّلة\n"
"  logout                            مسح كل الهويات النشطة\n"
"  logout-realm [NAME]               مسح الهويات في realm\n"
"  reload-creds                      إعادة تحميل بيانات الاعتماد واستعادة تسجيلات الدخول المخزّنة\n"
"  help                              عرض هذه المساعدة\n"
"\n"
"  الصدفات التفاعلية: sm, store, acl, cm, reg, id (exit أو Ctrl-D للخروج)\n"
"  لمرة واحدة: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  صيغة @realm:\n"
"    @factory-a          اسم الـ realm\n"
"    @device:tablet-1    نوع الـ realm + الاسم (الأنواع: global, device, app)\n"
"    @device             نوع الـ realm فقط\n"
"\n"
"options:\n"
"  (يجب أن تظهر الخيارات العامة قبل الأمر الفرعي، مثل acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          ملف تخزين بيانات الاعتماد\n"
"  -d, --user-db FILE                ملف JSON لمخزن المستخدمين (الافتراضي: عرض مدمج)\n"
"  -p, --policy-db FILE              ملف JSON لمخزن السياسات (الافتراضي: عرض مدمج)\n"
"  -u, --subject USER                تلميح الموضوع الافتراضي\n"
"  -r, --realm NAME                  اسم الـ realm الافتراضي\n"
"      --realm-type TYPE             نوع الـ realm الافتراضي (global|device|app)\n"
"      --realm-uuid UUID             uuid الـ realm الافتراضي\n"
"      --version                     طباعة الإصدار والخروج\n"
"  -h, --help                        عرض المساعدة والخروج\n"
"\n"
"أذونات العرض (ACL مدمج):\n"
"  action=view;resource=fab.order / action=modify;resource=fab.order /\n"
"  action=delete;resource=fab.order / action=save;resource=file\n"

