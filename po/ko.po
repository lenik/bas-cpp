#: src/bas/security/UserStoreCommand.cpp:67
msgid ""
"usage: user add [-h] [options] USER [PASSWORD]\n"
"  Create a new user record.\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    display name\n"
"  -e, --email EMAIL     email address\n"
"  -p, --password PASS   password (or positional PASSWORD)\n"
"  -H, --hash ALGO       plain (default), sha256, sha1, md5\n"
"  -r, --roles ROLES     comma-separated role names (default: operator)\n"
"  -h, --help            show this help\n"
"  If neither -p nor PASSWORD is given, password is read from stdin.\n"
msgstr ""
"사용법: user add [-h] [options] USER [PASSWORD]\n"
"  새 사용자 레코드를 만듭니다.\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    표시 이름\n"
"  -e, --email EMAIL     이메일 주소\n"
"  -p, --password PASS   비밀번호 (또는 위치 인수 PASSWORD)\n"
"  -H, --hash ALGO       plain(기본), sha256, sha1, md5\n"
"  -r, --roles ROLES     쉼표로 구분된 역할 이름(기본: operator)\n"
"  -h, --help            이 도움말 표시\n"
"  -p와 PASSWORD를 모두 생략하면 stdin에서 비밀번호를 읽습니다.\n"

#: src/bas/security/UserStoreCommand.cpp:81
msgid ""
"usage: user update [-h] [options] USER [PASSWORD]\n"
"  Update an existing user; only specified fields are changed.\n"
"options: same as user add\n"
msgstr ""
"사용법: user update [-h] [options] USER [PASSWORD]\n"
"  기존 사용자를 업데이트합니다. 지정한 필드만 변경됩니다.\n"
"options: user add와 동일\n"

#: src/bas/security/UserStoreCommand.cpp:87
msgid ""
"usage: user check [-h] USER [PASSWORD]\n"
"  Validate PASSWORD against USER's stored keys (exit 1 on failure).\n"
"  PASSWORD from stdin when omitted.\n"
msgstr ""
"사용법: user check [-h] USER [PASSWORD]\n"
"  USER의 저장된 키에 대해 PASSWORD를 검증합니다(실패 시 종료 코드 1).\n"
"  생략 시 stdin에서 PASSWORD를 읽습니다.\n"

#: src/bas/security/UserStoreCommand.cpp:93
msgid ""
"usage: user del|rm [-h] USER\n"
"  Remove USER from the store.\n"
msgstr ""
"사용법: user del|rm [-h] USER\n"
"  스토어에서 USER를 제거합니다.\n"

#: src/bas/security/UserStoreCommand.cpp:98
msgid ""
"usage: user enable|disable [-h] USER\n"
"  Enable or disable USER login.\n"
msgstr ""
"사용법: user enable|disable [-h] USER\n"
"  USER 로그인을 사용 또는 사용 안 함으로 설정합니다.\n"

#: src/bas/security/UserStoreCommand.cpp:103
msgid ""
"usage: user roles [-h] USER\n"
"       user roles set [-h] USER ROLE…\n"
"  List roles, or replace the role list for USER.\n"
msgstr ""
"사용법: user roles [-h] USER\n"
"       user roles set [-h] USER ROLE…\n"
"  역할을 나열하거나 USER의 역할 목록을 교체합니다.\n"

#: src/bas/security/UserStoreCommand.cpp:109
msgid ""
"usage: user role add [-h] USER ROLE\n"
"       user role del [-h] USER ROLE\n"
"  Add or remove a single role name on USER.\n"
msgstr ""
"사용법: user role add [-h] USER ROLE\n"
"       user role del [-h] USER ROLE\n"
"  USER에 단일 역할 이름을 추가하거나 제거합니다.\n"

#: src/bas/security/UserStoreCommand.cpp:115
msgid ""
"usage: user keys [-h] USER\n"
"  List authentication keys for USER.\n"
msgstr ""
"사용법: user keys [-h] USER\n"
"  USER의 인증 키를 나열합니다.\n"

#: src/bas/security/UserStoreCommand.cpp:120
msgid ""
"usage: user key add [-h] USER ID TYPE [options]\n"
"       user key del [-h] USER ID\n"
"options for add:\n"
"  -p, --password PASS   key secret\n"
"  -H, --hash ALGO       for password-hash (default plain → password-plain)\n"
"  --name LABEL          key display name\n"
"  -h, --help            show this help\n"
msgstr ""
"사용법: user key add [-h] USER ID TYPE [options]\n"
"       user key del [-h] USER ID\n"
"add용 options:\n"
"  -p, --password PASS   키 비밀\n"
"  -H, --hash ALGO       password-hash용 (기본 plain → password-plain)\n"
"  --name LABEL          키 표시 이름\n"
"  -h, --help            이 도움말 표시\n"

