#: app/reg.cpp:33
msgid ""
"usage: reg [options]\n"
"  -r, --root DIR|FILE   registry root (directory → LocalRegistry, file → JsonRegistry)\n"
"  -d, --dump PATH       list all keys under PATH (path=value lines)\n"
"  -g, --get PATH        print registry value (valueToString)\n"
"  -s, --set PATH VALUE  set registry value (parseOption)\n"
"  -e, --export PATH     export subtree at PATH as JSON to stdout\n"
"  -i, --import PATH     read JSON from stdin and merge at PATH\n"
"  -v, --verbose         debug logging\n"
"  -q, --quiet           errors only on stderr\n"
"      --version         print version and exit\n"
"  -h, --help            show this help and exit\n"
msgstr ""
"Aufruf: reg [Optionen]\n"
"  -r, --root DIR|FILE   Registry-Wurzel (Verzeichnis → LocalRegistry, Datei → JsonRegistry)\n"
"  -d, --dump PATH       alle Schlüssel unter PATH auflisten (Zeilen path=value)\n"
"  -g, --get PATH        Registry-Wert ausgeben (valueToString)\n"
"  -s, --set PATH VALUE  Registry-Wert setzen (parseOption)\n"
"  -e, --export PATH     Teilbaum unter PATH als JSON nach stdout exportieren\n"
"  -i, --import PATH     JSON von stdin lesen und unter PATH zusammenführen\n"
"  -v, --verbose         Debug-Protokollierung\n"
"  -q, --quiet           nur Fehler auf stderr\n"
"      --version         Version ausgeben und beenden\n"
"  -h, --help            diese Hilfe anzeigen und beenden\n"

