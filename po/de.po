#: src/bas/volume/Volume_utils.cpp:152
msgid "Usage: assets [OPTIONS] [PATH...]"
msgstr "Aufruf: assets [OPTIONEN] [PFAD...]"

#: src/bas/volume/Volume_utils.cpp:153
msgid "Options:"
msgstr "Optionen:"

#: src/bas/volume/Volume_utils.cpp:154
msgid "  -R, --recursive        list subdirectories recursively"
msgstr "  -R, --recursive        Unterverzeichnisse rekursiv auflisten"

#: src/bas/volume/Volume_utils.cpp:155
msgid "  -l, --long             use a long listing format"
msgstr "  -l, --long             langes Listenformat verwenden"

#: src/bas/volume/Volume_utils.cpp:156
msgid "  -a, --all              include entries starting with . and .."
msgstr ""
"  -a, --all              Einträge einschließen, die mit . und .. beginnen"

#: src/bas/volume/Volume_utils.cpp:157
msgid ""
"  -A, --almost-all       include entries starting with . except . and .."
msgstr ""
"  -A, --almost-all       Einträge einschließen, die mit . beginnen, außer . "
"und .."

#: src/bas/volume/Volume_utils.cpp:158
msgid "  -F, --classify         append file type indicators"
msgstr "  -F, --classify         Dateitypkennzeichen anhängen"

#: src/bas/volume/Volume_utils.cpp:159
msgid "  -h, --human-readable   print sizes in human-readable form"
msgstr "  -h, --human-readable   Größen in menschenlesbarer Form ausgeben"

#: src/bas/volume/Volume_utils.cpp:160
msgid "  -C, --color            enable colored output"
msgstr "  -C, --color            farbige Ausgabe aktivieren"

#: src/bas/volume/Volume_utils.cpp:161
msgid "  -T, --tree             print as directory tree"
msgstr "  -T, --tree             als Verzeichnisbaum ausgeben"

#: src/bas/volume/Volume_utils.cpp:162
msgid "      --help             display this help and exit"
msgstr "      --help             diese Hilfe anzeigen und beenden"
