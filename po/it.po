#: src/bas/security/CredentialManagerCommand.cpp:14
msgid ""
"credential commands:\n"
"  list [-v]              list cached credentials (no secrets)\n"
"  del STORE ID           remove credential by ref\n"
"  clear                  remove all credentials\n"
"  path                   show credential file path\n"
"  reload                 reload from disk\n"
"  save                   write credentials to disk\n"
"  help                   show this help\n"
msgstr ""
"comandi credenziali:\n"
"  list [-v]              elenca le credenziali in cache (senza segreti)\n"
"  del STORE ID           rimuovi credenziale per riferimento\n"
"  clear                  rimuovi tutte le credenziali\n"
"  path                   mostra il percorso del file credenziali\n"
"  reload                 ricarica dal disco\n"
"  save                   scrivi le credenziali sul disco\n"
"  help                   mostra questo aiuto\n"

