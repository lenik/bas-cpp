#: app/vols.cpp:39
msgid ""
"usage: vols [options]\n"
"  Field selection (default without any: -mdtlu; with -v: -mdtlurLD):\n"
"    -a, --all            all columns\n"
"    -c, --compact        same columns as -mdtlu (merges with explicit field flags)\n"
"    -m, --mountpoint     mount point column\n"
"    -d, --device         device column\n"
"    -t, --type           type column\n"
"    -l, --label          label column\n"
"    -u, --uuid           UUID column\n"
"    -r, --read-only      read-only (ro/rw) column\n"
"    -L, --logical-type   logical type column\n"
"    -D, --loop-device    loop device column\n"
"    -o, --opts           per-mount (VFS) options from mountinfo\n"
"    -O, --superopts      superblock options from mountinfo\n"
"    -z, --root           root path within filesystem (mountinfo field)\n"
"  Other:\n"
"    -s, --symbols        include overlay filesystems in the scan (bind mounts always on)\n"
"    -h, --help           show this help and exit\n"
"    -w, --writable       list only writable mounts; implies -r\n"
"    -v, --verbose        more log detail; default columns include logical type\n"
"    -q, --quiet          only errors on stderr\n"
msgstr ""
"uso: vols [opzioni]\n"
"  Selezione campi (predefinito senza alcuna: -mdtlu; con -v: -mdtlurLD):\n"
"    -a, --all            tutte le colonne\n"
"    -c, --compact        stesse colonne di -mdtlu (si unisce ai flag di campo espliciti)\n"
"    -m, --mountpoint     colonna punto di montaggio\n"
"    -d, --device         colonna dispositivo\n"
"    -t, --type           colonna tipo\n"
"    -l, --label          colonna etichetta\n"
"    -u, --uuid           colonna UUID\n"
"    -r, --read-only      colonna sola lettura (ro/rw)\n"
"    -L, --logical-type   colonna tipo logico\n"
"    -D, --loop-device    colonna dispositivo loop\n"
"    -o, --opts           opzioni per mount (VFS) da mountinfo\n"
"    -O, --superopts      opzioni superblocco da mountinfo\n"
"    -z, --root           percorso radice nel filesystem (campo mountinfo)\n"
"  Altro:\n"
"    -s, --symbols        includi i filesystem overlay nella scansione (bind mount sempre attivi)\n"
"    -h, --help           mostra questo aiuto ed esci\n"
"    -w, --writable       elenca solo i mount scrivibili; implica -r\n"
"    -v, --verbose        più dettagli di log; le colonne predefinite includono il tipo logico\n"
"    -q, --quiet          solo errori su stderr\n"

