#: app/reg.cpp:33
msgid ""
"usage: reg [options]\n"
"  -r, --root DIR|FILE   registry root (directory → LocalRegistry, file → JsonRegistry)\n"
"  -d, --dump PATH       list all keys under PATH (path=value lines)\n"
"  -g, --get PATH        print registry value (valueToString)\n"
"  -s, --set PATH VALUE  set registry value (parseOption)\n"
"  -e, --export PATH     export subtree at PATH as JSON to stdout\n"
"  -i, --import PATH     read JSON from stdin and merge at PATH\n"
"  -v, --verbose         debug logging\n"
"  -q, --quiet           errors only on stderr\n"
"      --version         print version and exit\n"
"  -h, --help            show this help and exit\n"
msgstr ""
"uso: reg [opzioni]\n"
"  -r, --root DIR|FILE   radice del registro (directory → LocalRegistry, file → JsonRegistry)\n"
"  -d, --dump PATH       elenca tutte le chiavi sotto PATH (righe path=value)\n"
"  -g, --get PATH        stampa il valore del registro (valueToString)\n"
"  -s, --set PATH VALUE  imposta il valore del registro (parseOption)\n"
"  -e, --export PATH     esporta il sottoalbero a PATH come JSON su stdout\n"
"  -i, --import PATH     leggi JSON da stdin e unisci a PATH\n"
"  -v, --verbose         registrazione di debug\n"
"  -q, --quiet           solo errori su stderr\n"
"      --version         stampa la versione ed esci\n"
"  -h, --help            mostra questo aiuto ed esci\n"

