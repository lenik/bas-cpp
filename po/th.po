#: src/bas/security/UserStoreCommand.cpp:34
msgid ""
"user store commands:\n"
"  user list                       list usernames\n"
"  user show USER                  show profile, roles, keys\n"
"  user add [options] USER [PASSWORD]\n"
"  user update [options] USER [PASSWORD]\n"
"      -a/--avatar NAME   -d/--display NAME   -e/--email EMAIL\n"
"      -p/--password PASS  [PASSWORD] positional\n"
"      -H/--hash ALGO      plain (default), sha256, sha1, md5\n"
"      -h/--help           show command help\n"
"      -r/--roles ROLES    comma-separated role names\n"
"      password from stdin when -p and [PASSWORD] are both omitted\n"
"  user check USER [PASSWORD]        validate password (exit 1 on failure)\n"
"  user del USER                   remove user\n"
"  user enable USER | user disable USER\n"
"  user roles USER | user roles set USER R…\n"
"  user role add USER ROLE | user role del USER ROLE\n"
"  user keys USER | user key add/del …\n"
"  path | reload | save | help\n"
"  commands may be abbreviated by unique prefix\n"
"  -h/--help on any subcommand shows its usage\n"
msgstr ""
"คำสั่งที่เก็บผู้ใช้:\n"
"  user list                       แสดงรายชื่อผู้ใช้\n"
"  user show USER                  แสดงโปรไฟล์ บทบาท คีย์\n"
"  user add [options] USER [PASSWORD]\n"
"  user update [options] USER [PASSWORD]\n"
"      -a/--avatar NAME   -d/--display NAME   -e/--email EMAIL\n"
"      -p/--password PASS  [PASSWORD] ตามตำแหน่ง\n"
"      -H/--hash ALGO      plain (ค่าเริ่มต้น), sha256, sha1, md5\n"
"      -h/--help           แสดงความช่วยเหลือของคำสั่ง\n"
"      -r/--roles ROLES    ชื่อบทบาทคั่นด้วยจุลภาค\n"
"      อ่านรหัสผ่านจาก stdin เมื่อละทั้ง -p และ [PASSWORD]\n"
"  user check USER [PASSWORD]        ตรวจสอบรหัสผ่าน (ออกด้วยรหัส 1 เมื่อล้มเหลว)\n"
"  user del USER                   ลบผู้ใช้\n"
"  user enable USER | user disable USER\n"
"  user roles USER | user roles set USER R…\n"
"  user role add USER ROLE | user role del USER ROLE\n"
"  user keys USER | user key add/del …\n"
"  path | reload | save | help\n"
"  คำสั่งอาจย่อด้วยคำนำหน้าที่ไม่ซ้ำ\n"
"  -h/--help บนคำสั่งย่อยใดๆ แสดงวิธีใช้\n"

#: src/bas/security/UserStoreCommand.cpp:57
msgid ""
"usage: user list [-h]\n"
"  List all usernames in the store.\n"
msgstr ""
"วิธีใช้: user list [-h]\n"
"  แสดงชื่อผู้ใช้ทั้งหมดในที่เก็บ\n"

#: src/bas/security/UserStoreCommand.cpp:62
msgid ""
"usage: user show [-h] USER\n"
"  Show profile, roles, and auth keys for USER.\n"
msgstr ""
"วิธีใช้: user show [-h] USER\n"
"  แสดงโปรไฟล์ บทบาท และคีย์ยืนยันตัวตนของ USER\n"

#: src/bas/security/UserStoreCommand.cpp:67
msgid ""
"usage: user add [-h] [options] USER [PASSWORD]\n"
"  Create a new user record.\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    display name\n"
"  -e, --email EMAIL     email address\n"
"  -p, --password PASS   password (or positional PASSWORD)\n"
"  -H, --hash ALGO       plain (default), sha256, sha1, md5\n"
"  -r, --roles ROLES     comma-separated role names (default: operator)\n"
"  -h, --help            show this help\n"
"  If neither -p nor PASSWORD is given, password is read from stdin.\n"
msgstr ""
"วิธีใช้: user add [-h] [options] USER [PASSWORD]\n"
"  สร้างระเบียนผู้ใช้ใหม่\n"
"options:\n"
"  -a, --avatar NAME     profile.attributes.avatar\n"
"  -d, --display NAME    ชื่อที่แสดง\n"
"  -e, --email EMAIL     ที่อยู่อีเมล\n"
"  -p, --password PASS   รหัสผ่าน (หรือ PASSWORD ตามตำแหน่ง)\n"
"  -H, --hash ALGO       plain (ค่าเริ่มต้น), sha256, sha1, md5\n"
"  -r, --roles ROLES     ชื่อบทบาทคั่นด้วยจุลภาค (ค่าเริ่มต้น: operator)\n"
"  -h, --help            แสดงความช่วยเหลือนี้\n"
"  หากไม่ระบุทั้ง -p และ PASSWORD จะอ่านรหัสผ่านจาก stdin\n"

#: src/bas/security/UserStoreCommand.cpp:81
msgid ""
"usage: user update [-h] [options] USER [PASSWORD]\n"
"  Update an existing user; only specified fields are changed.\n"
"options: same as user add\n"
msgstr ""
"วิธีใช้: user update [-h] [options] USER [PASSWORD]\n"
"  อัปเดตผู้ใช้ที่มีอยู่ เฉพาะฟิลด์ที่ระบุเท่านั้นที่จะเปลี่ยน\n"
"options: เหมือน user add\n"

#: src/bas/security/UserStoreCommand.cpp:87
msgid ""
"usage: user check [-h] USER [PASSWORD]\n"
"  Validate PASSWORD against USER's stored keys (exit 1 on failure).\n"
"  PASSWORD from stdin when omitted.\n"
msgstr ""
"วิธีใช้: user check [-h] USER [PASSWORD]\n"
"  ตรวจสอบ PASSWORD กับคีย์ที่เก็บของ USER (ออกด้วยรหัส 1 เมื่อล้มเหลว)\n"
"  อ่าน PASSWORD จาก stdin เมื่อละไว้\n"

#: src/bas/security/UserStoreCommand.cpp:93
msgid ""
"usage: user del|rm [-h] USER\n"
"  Remove USER from the store.\n"
msgstr ""
"วิธีใช้: user del|rm [-h] USER\n"
"  ลบ USER ออกจากที่เก็บ\n"

#: src/bas/security/UserStoreCommand.cpp:98
msgid ""
"usage: user enable|disable [-h] USER\n"
"  Enable or disable USER login.\n"
msgstr ""
"วิธีใช้: user enable|disable [-h] USER\n"
"  เปิดหรือปิดการเข้าสู่ระบบของ USER\n"

#: src/bas/security/UserStoreCommand.cpp:103
msgid ""
"usage: user roles [-h] USER\n"
"       user roles set [-h] USER ROLE…\n"
"  List roles, or replace the role list for USER.\n"
msgstr ""
"วิธีใช้: user roles [-h] USER\n"
"       user roles set [-h] USER ROLE…\n"
"  แสดงรายการบทบาท หรือแทนที่รายการบทบาทของ USER\n"

#: src/bas/security/UserStoreCommand.cpp:109
msgid ""
"usage: user role add [-h] USER ROLE\n"
"       user role del [-h] USER ROLE\n"
"  Add or remove a single role name on USER.\n"
msgstr ""
"วิธีใช้: user role add [-h] USER ROLE\n"
"       user role del [-h] USER ROLE\n"
"  เพิ่มหรือลบชื่อบทบาทเดียวบน USER\n"

#: src/bas/security/UserStoreCommand.cpp:115
msgid ""
"usage: user keys [-h] USER\n"
"  List authentication keys for USER.\n"
msgstr ""
"วิธีใช้: user keys [-h] USER\n"
"  แสดงรายการคีย์ยืนยันตัวตนของ USER\n"

#: src/bas/security/UserStoreCommand.cpp:120
msgid ""
"usage: user key add [-h] USER ID TYPE [options]\n"
"       user key del [-h] USER ID\n"
"options for add:\n"
"  -p, --password PASS   key secret\n"
"  -H, --hash ALGO       for password-hash (default plain → password-plain)\n"
"  --name LABEL          key display name\n"
"  -h, --help            show this help\n"
msgstr ""
"วิธีใช้: user key add [-h] USER ID TYPE [options]\n"
"       user key del [-h] USER ID\n"
"options สำหรับ add:\n"
"  -p, --password PASS   ความลับของคีย์\n"
"  -H, --hash ALGO       สำหรับ password-hash (ค่าเริ่มต้น plain → password-plain)\n"
"  --name LABEL          ชื่อที่แสดงของคีย์\n"
"  -h, --help            แสดงความช่วยเหลือนี้\n"

