#: app/vols.cpp:39
msgid ""
"usage: vols [options]\n"
"  Field selection (default without any: -mdtlu; with -v: -mdtlurLD):\n"
"    -a, --all            all columns\n"
"    -c, --compact        same columns as -mdtlu (merges with explicit field flags)\n"
"    -m, --mountpoint     mount point column\n"
"    -d, --device         device column\n"
"    -t, --type           type column\n"
"    -l, --label          label column\n"
"    -u, --uuid           UUID column\n"
"    -r, --read-only      read-only (ro/rw) column\n"
"    -L, --logical-type   logical type column\n"
"    -D, --loop-device    loop device column\n"
"    -o, --opts           per-mount (VFS) options from mountinfo\n"
"    -O, --superopts      superblock options from mountinfo\n"
"    -z, --root           root path within filesystem (mountinfo field)\n"
"  Other:\n"
"    -s, --symbols        include overlay filesystems in the scan (bind mounts always on)\n"
"    -h, --help           show this help and exit\n"
"    -w, --writable       list only writable mounts; implies -r\n"
"    -v, --verbose        more log detail; default columns include logical type\n"
"    -q, --quiet          only errors on stderr\n"
msgstr ""
"วิธีใช้: vols [options]\n"
"  การเลือกฟิลด์ (ค่าเริ่มต้นเมื่อไม่ระบุ: -mdtlu; กับ -v: -mdtlurLD):\n"
"    -a, --all            คอลัมน์ทั้งหมด\n"
"    -c, --compact        คอลัมน์เดียวกับ -mdtlu (รวมกับแฟลกฟิลด์ที่ระบุ)\n"
"    -m, --mountpoint     คอลัมน์จุดเมานต์\n"
"    -d, --device         คอลัมน์อุปกรณ์\n"
"    -t, --type           คอลัมน์ประเภท\n"
"    -l, --label          คอลัมน์ป้าย\n"
"    -u, --uuid           คอลัมน์ UUID\n"
"    -r, --read-only      คอลัมน์อ่านอย่างเดียว (ro/rw)\n"
"    -L, --logical-type   คอลัมน์ประเภทเชิงตรรกะ\n"
"    -D, --loop-device    คอลัมน์อุปกรณ์ลูป\n"
"    -o, --opts           ตัวเลือกต่อเมานต์ (VFS) จาก mountinfo\n"
"    -O, --superopts      ตัวเลือกซูเปอร์บล็อกจาก mountinfo\n"
"    -z, --root           เส้นทางรากในระบบไฟล์ (ฟิลด์ mountinfo)\n"
"  อื่นๆ:\n"
"    -s, --symbols        รวมระบบไฟล์ overlay ในการสแกน (bind mount เปิดเสมอ)\n"
"    -h, --help           แสดงความช่วยเหลือนี้แล้วออก\n"
"    -w, --writable       แสดงเฉพาะเมานต์ที่เขียนได้; หมายถึง -r\n"
"    -v, --verbose        รายละเอียดบันทึกเพิ่มเติม; คอลัมน์เริ่มต้นรวมประเภทเชิงตรรกะ\n"
"    -q, --quiet          ข้อผิดพลาดเท่านั้นบน stderr\n"

