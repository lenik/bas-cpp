#: app/acdemo.cpp:102
msgid ""
"acdemo — bas.security permissions, credentials, and console login demo\n"
"\n"
"usage: acdemo [options] [command [args...]]\n"
"\n"
"  If no command is given, starts an interactive shell.\n"
"\n"
"commands:\n"
"  check [@realm] PERMISSION       check permission (optional realm scope)\n"
"  request [@realm] PERMISSION [USER]  request permission (login if needed)\n"
"  login [@realm] [USER]             interactive login → active identities\n"
"  whoami                            list active identities\n"
"  creds [-v]                        list cached credentials (no secrets)\n"
"  sm                                enter security manager shell\n"
"  us                                enter user store shell\n"
"  cm                                enter credential manager shell\n"
"  ps                                enter policy store shell\n"
"  reg                               enter identity registry shell\n"
"  id                                enter identity service shell (current realm)\n"
"  realm show|NAME|@realm            show or switch current realm\n"
"  realms                            list registered realms\n"
"  logout                            clear all active identities\n"
"  logout-realm [NAME]               clear identities in a realm\n"
"  reload-creds                      reload credentials and restore cached logins\n"
"  help                              show this help\n"
"\n"
"  Interactive shells: sm, store, acl, cm, reg, id (exit or Ctrl-D to leave)\n"
"  One-shot: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  @realm syntax:\n"
"    @factory-a          realm name\n"
"    @device:tablet-1    realm type + name (types: global, device, app)\n"
"    @device             realm type only\n"
"\n"
"options:\n"
"  (global options must appear before the subcommand, e.g. acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          credential cache file\n"
"  -d, --user-db FILE                user store JSON file (default: built-in demo)\n"
"  -p, --policy-db FILE              policy store JSON file (default: built-in demo)\n"
"  -u, --subject USER                default subject hint\n"
"  -r, --realm NAME                  default realm name\n"
"      --realm-type TYPE             default realm type (global|device|app)\n"
"      --realm-uuid UUID             default realm uuid\n"
"      --version                     print version and exit\n"
"  -h, --help                        show help and exit\n"
"\n"
"demo permissions (ACL is built-in):\n"
"  action=view;resource=fab.order / action=modify;resource=fab.order /\n"
"  action=delete;resource=fab.order / action=save;resource=file\n"
msgstr ""
"acdemo — demo quyền, thông tin xác thực và đăng nhập console của bas.security\n"
"\n"
"cách dùng: acdemo [options] [command [args...]]\n"
"\n"
"  Nếu không có lệnh, khởi động shell tương tác.\n"
"\n"
"commands:\n"
"  check [@realm] PERMISSION       kiểm tra quyền (phạm vi realm tùy chọn)\n"
"  request [@realm] PERMISSION [USER]  yêu cầu quyền (đăng nhập nếu cần)\n"
"  login [@realm] [USER]             đăng nhập tương tác → danh tính đang hoạt động\n"
"  whoami                            liệt kê danh tính đang hoạt động\n"
"  creds [-v]                        liệt kê thông tin xác thực trong bộ nhớ đệm (không có bí mật)\n"
"  sm                                vào shell trình quản lý bảo mật\n"
"  us                                vào shell kho người dùng\n"
"  cm                                vào shell trình quản lý thông tin xác thực\n"
"  ps                                vào shell kho chính sách\n"
"  reg                               vào shell registry danh tính\n"
"  id                                vào shell dịch vụ danh tính (realm hiện tại)\n"
"  realm show|NAME|@realm            hiện hoặc chuyển realm hiện tại\n"
"  realms                            liệt kê các realm đã đăng ký\n"
"  logout                            xóa tất cả danh tính đang hoạt động\n"
"  logout-realm [NAME]               xóa danh tính trong một realm\n"
"  reload-creds                      tải lại thông tin xác thực và khôi phục đăng nhập trong bộ nhớ đệm\n"
"  help                              hiện trợ giúp này\n"
"\n"
"  Shell tương tác: sm, store, acl, cm, reg, id (exit hoặc Ctrl-D để thoát)\n"
"  Một lần: store SUBCMD … | cm SUBCMD … | creds [-v]\n"
"\n"
"  Cú pháp @realm:\n"
"    @factory-a          tên realm\n"
"    @device:tablet-1    loại realm + tên (loại: global, device, app)\n"
"    @device             chỉ loại realm\n"
"\n"
"options:\n"
"  (tùy chọn toàn cục phải đứng trước lệnh con, vd. acdemo -d user.db store …)\n"
"  -f, --credential-db PATH          tệp bộ nhớ đệm thông tin xác thực\n"
"  -d, --user-db FILE                tệp JSON kho người dùng (mặc định: demo tích hợp)\n"
"  -p, --policy-db FILE              tệp JSON kho chính sách (mặc định: demo tích hợp)\n"
"  -u, --subject USER                gợi ý chủ thể mặc định\n"
"  -r, --realm NAME                  tên realm mặc định\n"
"      --realm-type TYPE             loại realm mặc định (global|device|app)\n"
"      --realm-uuid UUID             uuid realm mặc định\n"
"      --version                     in phiên bản và thoát\n"
"  -h, --help                        hiện trợ giúp và thoát\n"
"\n"
"quyền demo (ACL tích hợp):\n"
"  fab.order.view / fab.order.modify / fab.order.delete / file.save\n"

